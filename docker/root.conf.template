server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Compress text-based assets.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/css
        application/javascript
        application/json
        image/svg+xml
        application/wasm;

    # The SPA entry must always be revalidated, otherwise browsers keep a
    # stale shell after a deploy (new JS chunks would be missing).
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Unhashed files get a short cache.
    location = /favicon.ico {
        expires 7d;
        add_header Cache-Control "public";
    }

    # Hashed build assets (Vite content-hashes all filenames) can be cached
    # aggressively and forever.
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback — all non-file routes serve index.html.
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ /index.html;
    }
}
