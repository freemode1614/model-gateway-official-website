{
  "name": "react-fsroutes-spa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "serve -s build/client -l 3000",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:cf": "pnpm run build && wrangler deploy",
    "preview:cf": "pnpm run build && wrangler dev",
    "api:gen": "apicodegen https://petstore.swagger.io/v2/swagger.json -o app/api/petstore.ts -a fetch -b https://petstore.swagger.io/v2"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-router/fs-routes": "^8.1.0",
    "@react-router/node": "^8.1.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.50.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@moccona/apicodegen": "^0.1.1",
    "@react-router/dev": "^8.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.1.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.2"
  }
}
