# ---------------------------------------------------------------------------
# Environment variables
#
# Client-visible variables must use the WEBAPP_ prefix (set via
# `envOptions.envPrefix` in vite.config.ts) and are exposed to the app through
# `import.meta.env.WEBAPP_*`. Copy this file to `.env` (gitignored) to override.
#
# The same variables are also read at build/dev time:
#   - vite.config.ts       reads them via loadEnv() with the WEBAPP_ prefix
#   - react-router.config.ts reads them from process.env directly
# so a single source of truth drives the generated API client, the running
# app, and the router's basename.
# ---------------------------------------------------------------------------

# Base URL of the Petstore API used by the generated client (app/api/petstore.ts)
WEBAPP_PETSTORE_BASE_URL=https://petstore.swagger.io/v2

# Hosted OpenAPI spec the Vite plugin generates the client from.
# After changing it, regenerate the client: pnpm api:gen (or restart pnpm dev).
WEBAPP_PETSTORE_SPEC_URL=https://petstore.swagger.io/v2/swagger.json

# URL path prefix the SPA is hosted under. Leave empty (or unset) to serve
# the app from the site root. Use a leading slash and no trailing slash, for
# example: WEBAPP_BASE_URL=/admin to host under https://example.com/admin/.
# This value is consumed by react-router.config.ts and passed to React
# Router's `basename`, so a full rebuild is required after changing it.
#
# Examples:
#   WEBAPP_BASE_URL=                       # root:        https://example.com/
#   WEBAPP_BASE_URL=/admin                 # one segment: https://example.com/admin/
#
# When set, ensure the host serves the SPA from that prefix:
#   - nginx: `location /admin/ { try_files $uri $uri/ /admin/index.html; }`
#   - or rewrite the prefix internally and keep the static fallback.
WEBAPP_BASE_URL=
